# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (SQLite file path)
# In production on Render with a Persistent Disk: e.g. /var/data/digital_gift_paradise.db
# In development or ephemeral disk: ./data/digital_gift_paradise.db
DB_PATH=./data/digital_gift_paradise.db

# CORS Allowed Origins (comma-separated URLs, or * for open API)
# In production, specify your deployed Vercel frontend URL, e.g.:
# CORS_ORIGIN=https://cart-checkout.vercel.app,http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
